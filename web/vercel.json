{
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "https://atlas-backend-6oqp.onrender.com/api/:match*"
    },
    {
      "source": "/uploads/:match*",
      "destination": "https://atlas-backend-6oqp.onrender.com/uploads/:match*"
    },
    {
      "source": "/((?!api|uploads).*)",
      "destination": "/index.html"
    }
  ]
}
